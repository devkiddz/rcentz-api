model ServiceMilestoneTemplate {
  id        String @id @default(cuid())
  serviceId String

  title           String
  slug            String
  description     String?
  purpose         String?
  expectedOutcome String?
  minDays         Int?
  maxDays         Int?
  sortOrder       Int     @default(0)

