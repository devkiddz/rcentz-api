// =========================================================
// USERS / AUTHENTICATION
// Better Auth owns the core account/session contract.
// Role and status authorization remains server-enforced.
// =========================================================

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  phone         String?
  bio           String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastSeenAt    DateTime?

  accounts Account[]
  sessions Session[]

  clientProfile ClientProfile?
  staffProfile  StaffProfile?

  clientProjects Project[] @relation("ProjectClient")

  assignedProjects    ProjectAssignment[]
  createdAttributions ProjectAttribution[]

  milestoneRecordRequests ProjectMilestoneRecord[] @relation("MilestoneRecordRequester")
  milestoneRecordPrepared ProjectMilestoneRecord[] @relation("MilestoneRecordPreparer")

  createdMilestones       ProjectMilestone[]           @relation("MilestoneCreator")
  milestoneAssignments    ProjectMilestoneAssignment[]
  createdDeliverables     ProjectDeliverable[]         @relation("DeliverableCreator")
  createdProjectProcesses ProjectProcess[]             @relation("ProjectProcessCreator")

  createdFeatures   ProjectFeature[] @relation("FeatureCreator")
  nominatedFeatures ProjectFeature[] @relation("FeatureNominator")
  assignedFeatures  ProjectFeature[] @relation("FeatureAssignee")

  createdTasks  ProjectTask[] @relation("TaskCreator")
  assignedTasks ProjectTask[] @relation("TaskAssignee")

  createdProjectUpdates ProjectUpdate[]   @relation("ProjectUpdateAuthor")
  projectActivities     ProjectActivity[]
  uploadedProjectFiles  ProjectFile[]     @relation("ProjectFileUploader")

  serviceRequests ServiceRequest[]
  quotes          Quote[]          @relation("QuoteClient")

  createdServicePlans  ServicePlan[]        @relation("ServicePlanCreator")
  customServicePlans   ServicePlan[]        @relation("ServicePlanClient")
  subscriptions        ClientSubscription[] @relation("SubscriptionClient")
  createdSubscriptions ClientSubscription[] @relation("SubscriptionCreator")

  invoices        Invoice[] @relation("InvoiceClient")
  createdInvoices Invoice[] @relation("InvoiceCreator")
  payments        Payment[] @relation("PaymentPayer")

  proposedInvoiceRevisions  InvoiceRevision[] @relation("InvoiceRevisionProposer")
  acceptedInvoiceRevisions  InvoiceRevision[] @relation("InvoiceRevisionAccepter")
  rejectedInvoiceRevisions  InvoiceRevision[] @relation("InvoiceRevisionRejecter")
  cancelledInvoiceRevisions InvoiceRevision[] @relation("InvoiceRevisionCanceller")

  clientApprovals          ClientApproval[] @relation("ClientApprovalClient")
  requestedClientApprovals ClientApproval[] @relation("ClientApprovalRequester")
  respondedClientApprovals ClientApproval[] @relation("ClientApprovalResponder")
  cancelledClientApprovals ClientApproval[] @relation("ClientApprovalCanceller")

  orders Order[]
  carts  Cart[]

  comments  Comment[]
  reactions Reaction[]

  conversations ConversationParticipant[]
  sentMessages  Message[]                 @relation("MessageSender")

  notifications          Notification[]
  notificationPreference NotificationPreference?

  assistanceRequests AssistanceRequest[]

  createdTickets  SupportTicket[] @relation("TicketCreator")
  assignedTickets SupportTicket[] @relation("TicketAssignee")

  analyticsEvents   AnalyticsEvent[]
  analyticsSessions AnalyticsSession[]

  auditLogs AuditLog[]

  createdServices Service[]  @relation("ServiceCreator")
  authoredPosts   BlogPost[] @relation("PostAuthor")

  mediaAssets MediaAsset[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("user")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  issuer                String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([providerId])
  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

// =========================================================
// CLIENT / STAFF
// =========================================================

model ClientProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String?
  companyLogo String?
  website     String?
  phone       String?
  bio         String?
  address     String?
  city        String?
  state       String?
  country     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StaffProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  jobTitle         String?
  department       String?
  employeeNumber   String?          @unique
  employmentStatus EmploymentStatus @default(ACTIVE)
  joinedAt         DateTime?
  terminatedAt     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =========================================================
// SERVICES — CATALOGUE, INTELLIGENCE, ONBOARDING & REQUESTS
// Service records describe reusable commercial offerings.
// Service milestone templates describe a typical delivery path.
// Real execution lives in Project -> ProjectMilestone after conversion.
// =========================================================

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  sortOrder   Int      @default(0)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]

  @@index([sortOrder])
  @@index([featured])
}

model Service {
  id               String        @id @default(cuid())
  categoryId       String?
  createdById      String
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?
  type             ProjectType
  status           ServiceStatus @default(DRAFT)
  featured         Boolean       @default(false)
  sortOrder        Int           @default(0)

  deliveryMinDays Int?
  deliveryMaxDays Int?
  deliveryNote    String?
  publishedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User             @relation("ServiceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  prices              ServicePrice[]
  technologies        ServiceTechnology[]
  features            ServiceFeature[]
  outcomes            ServiceOutcome[]
  milestoneTemplates  ServiceMilestoneTemplate[]
  faqs                ServiceFaq[]
  onboardingQuestions ServiceOnboardingQuestion[]

  requests     ServiceRequest[]
  planLinks    ServicePlanService[]
  entitlements ServicePlanEntitlement[]
  invoiceItems InvoiceItem[]
  quoteItems   QuoteItem[]
  media        MediaAsset[]
  seo          SeoMetadata?

  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([featured])
  @@index([sortOrder])
  @@index([publishedAt])
}

model ServicePrice {
  id        String @id @default(cuid())
  serviceId String

  currency  String
  priceFrom Decimal  @db.Decimal(14, 2)
  priceTo   Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, currency])
  @@index([serviceId])
  @@index([currency])
}

model ServiceTechnology {
  id        String @id @default(cuid())
  serviceId String

  name        String
  slug        String
  icon        String?
  category    String?
  description String?
  purpose     String?
  rationale   String?
  sortOrder   Int     @default(0)
  featured    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, slug])
  @@index([serviceId, sortOrder])
  @@index([slug])
  @@index([featured])
}

model ServiceFeature {
  id        String @id @default(cuid())
  serviceId String

  name            String
  slug            String
  description     String?
  expectedOutcome String?
  sortOrder       Int     @default(0)
  featured        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, slug])
  @@index([serviceId, sortOrder])
  @@index([featured])
}

model ServiceOutcome {
  id        String @id @default(cuid())
  serviceId String

  title       String
  slug        String
  description String?
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

